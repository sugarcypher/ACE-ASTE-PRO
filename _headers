# GitHub Pages headers for caching and compression
# Note: GitHub Pages doesn't support custom headers directly
# These would need to be configured at CDN/proxy level (Cloudflare, etc.)

# Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-a4932a61c270aa4cc6519158bbf6245ae2a71ba480951248c20e09601ba6762e' 'sha256-42990002847620bd43394d03506c00174cf9f20728e4f8e0bdd34280b13d37d4' https://app.termly.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://app.termly.io; frame-src 'self' https://app.termly.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; require-trusted-types-for 'script'; upgrade-insecure-requests;

# HSTS (HTTP Strict Transport Security)
# WARNING: 'preload' is permanent - only add after thorough testing
# Start with low max-age for testing, then increase to 1 year before adding preload
# Current: max-age=31536000; includeSubDomains; preload
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache static assets for 1 year
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/app-critical.js
  Cache-Control: public, max-age=31536000, immutable

/app-termly.js
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML for shorter period
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

