# ============================================================================
# Security Headers Configuration
# ============================================================================
# 
# This file is used by platforms that support custom HTTP headers:
# - Cloudflare Pages: Automatically reads _headers file
# - Netlify: Automatically reads _headers file  
# - Vercel: Requires vercel.json configuration (see below)
#
# GitHub Pages: Does NOT support custom headers. Headers must be set via:
#   - Meta tags in HTML (limited support)
#   - CDN/proxy layer (Cloudflare, etc.)
#
# ============================================================================
# WHY WEBBKOLL STILL FLAGS MISSING HEADERS ON GITHUB PAGES
# ============================================================================
#
# Webbkoll and Mozilla Observatory scan HTTP response headers, not meta tags.
# Even though we have a strong CSP in a <meta> tag, these tools cannot see it
# as an HTTP header. They will flag:
#   - Missing X-Content-Type-Options header
#   - Missing X-Frame-Options header  
#   - Missing Strict-Transport-Security header
#   - Missing Referrer-Policy header (as HTTP header)
#
# To achieve 100% scores:
#   1. Deploy to Cloudflare Pages, Netlify, or Vercel (supports _headers)
#   2. Or use GitHub Pages + Cloudflare proxy (set headers in Cloudflare)
#   3. Or use a custom server that can set HTTP headers
#
# ============================================================================
# HEADERS THAT GITHUB PAGES CANNOT SET
# ============================================================================
#
# GitHub Pages does NOT support:
#   ❌ X-Content-Type-Options
#   ❌ X-Frame-Options (can use CSP frame-ancestors in meta tag)
#   ❌ X-XSS-Protection
#   ❌ Strict-Transport-Security (HSTS)
#   ❌ Referrer-Policy (as HTTP header - meta tag works but not counted)
#   ❌ Content-Security-Policy (as HTTP header - meta tag works but not counted)
#   ❌ Permissions-Policy
#   ❌ Cross-Origin-Opener-Policy
#   ❌ Cross-Origin-Embedder-Policy
#
# GitHub Pages DOES support (via meta tags):
#   ✅ Content-Security-Policy (via <meta http-equiv>)
#   ✅ Referrer-Policy (via <meta name="referrer">)
#
# ============================================================================
# GLOBAL SECURITY HEADERS (Applied to all routes)
# ============================================================================

/*
  # Content Security Policy
  # Strict CSP with no unsafe-inline, explicit hashes for all inline scripts
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-ctK80pXSAwHb9TdKWV/OoTKdB/I5N16sDnC669JkHqw=' 'sha256-ctAI/7ecEjZpMFjuJyBCBzVNAmn1ga/2OIBUgVta2ds=' 'sha256-hsI2XKScePfqq9a84r1JImigfnKFnMJwt3JXol1INWU=' 'sha256-zS73P5wKtXDP7d1hEljlRxqwP1PqhD2MSrJKqdNv2EA=' https://app.termly.io https://cmp.gatekeeperconsent.com https://the.gatekeeperconsent.com https://privacy.gatekeeperconsent.com; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://eqoltjofjlznlirbalrb.supabase.co https://app.termly.io https://cmp.gatekeeperconsent.com https://the.gatekeeperconsent.com https://privacy.gatekeeperconsent.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; upgrade-insecure-requests; report-uri https://eqoltjofjlznlirbalrb.supabase.co/functions/v1/csp-report

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Prevent clickjacking (redundant with CSP frame-ancestors, but some tools expect it)
  X-Frame-Options: DENY

  # Disable legacy XSS filter (modern browsers use CSP instead)
  X-XSS-Protection: 0

  # Strict Transport Security (HSTS)
  # WARNING: 'preload' is permanent - only add after thorough testing
  # max-age=31556952 = 1 year (365.25 days)
  Strict-Transport-Security: max-age=31556952; includeSubDomains; preload

  # Referrer Policy - no referrer information sent
  Referrer-Policy: no-referrer

  # Permissions Policy - disable unnecessary features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

  # Cross-Origin Policies
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # NOTE: COEP require-corp is intentionally omitted from the global rule.
  # It would break cross-origin consent scripts (Termly/Gatekeeper) that do
  # not set CORP headers. Apply per-route if needed in a COEP-safe context.

# ── account.html override ────────────────────────────────────────────────────
# account.html contains an inline <script> block. Until it is extracted to
# account.js and hashed, we use unsafe-inline for scripts on this route only.
# All other directives remain strict; connect-src is scoped to Supabase only
# (no third-party consent scripts on this page).
/account.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://eqoltjofjlznlirbalrb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; report-uri https://eqoltjofjlznlirbalrb.supabase.co/functions/v1/csp-report
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31556952; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups

