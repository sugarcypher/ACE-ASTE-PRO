# Apache .htaccess configuration for ads.txt handling
# 
# NOTE: GitHub Pages does NOT support .htaccess or PHP
# This is for self-hosted Apache servers only
#
# For GitHub Pages: Use Cloudflare Worker (see cloudflare-worker-ads.txt.js)

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route /ads.txt requests to PHP handler
    RewriteRule ^ads\.txt$ ads-handler.php [L]
</IfModule>



